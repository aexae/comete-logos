@aexae:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_AUTH_TOKEN}

# Les peer deps @aexae/* ne servent qu'à l'exécution, chez l'application
# consommatrice : rien dans src/ ne les importe (les tokens sont résolus en CSS
# via var(--token)). Sans ce réglage, pnpm télécharge un package GitHub Packages
# privé pour rien — et la CI échoue en 403.
auto-install-peers=false
